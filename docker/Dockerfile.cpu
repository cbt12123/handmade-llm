# =============================================================================
# LLM_Line 轻量环境（无 NVIDIA 显卡时）
#   - 体积约 1.5GB，可跑通第 1~6 章全部脚本
#   - 第 7 章脚本会自动 SKIP（并打印 CPU 模拟结果）
#
#   docker build -f docker/Dockerfile.cpu -t llm-line:cpu .
#   docker run --rm -it -v "$PWD":/workspace -w /workspace llm-line:cpu bash
# =============================================================================
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl vim \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir \
        torch==2.1.2 --index-url https://download.pytorch.org/whl/cpu \
    && python3 -m pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /workspace
COPY . /workspace

RUN python3 -c "import torch, numpy; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

CMD ["bash"]
